# Copy to .env (gitignored). Every value has a code default; set only what you change.
# Loaded two ways: `make` includes and exports this file when it exists; for a plain shell run
# `set -a; . ./.env; set +a`. Keep the format KEY=value with no quotes and comments on their own
# lines (both loaders would otherwise keep them as part of the value).

# The `default` AWS profile's key is invalid; every aws/sam call uses this one (Makefile default).
AWS_PROFILE=firstcommit
# Everything deploys to Mumbai.
AWS_REGION=ap-south-1

# 1 = every external call reads fixtures; 0 = live AWS + upstream sources.
DEMO_MODE=1
# Where DEMO_MODE fixtures live (default: <repo>/fixtures).
#FIXTURES_DIR=fixtures
# Local JSON/file store standing in for DynamoDB + S3 in demo mode (default: <repo>/.demo_store).
#DEMO_STORE_DIR=.demo_store

# Bedrock: primary region, then one retry in the fallback region when the primary refuses.
BEDROCK_REGION=ap-south-1
BEDROCK_FALLBACK_REGION=us-east-1
# Claude Haiku 4.5: verify + claim letter.
MODEL_VERIFY=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Nova Lite: CDSCO rows -> Notice schema (apac. becomes us. on fallback).
MODEL_NORMALISE=apac.amazon.nova-lite-v1:0

# SES-verified identity in ap-south-1 (sandbox: the recipient must be verified too).
NOTIFY_EMAIL=you@example.com

# Live stack names, from `sam deploy` outputs. Unset = recallindia-<kind> defaults.
#NOTICES_TABLE=
#ITEMS_TABLE=
#CASES_TABLE=
#RAW_BUCKET=
#EVIDENCE_BUCKET=
#CLAIMS_BUCKET=
# Asymmetric RSA_2048 SIGN_VERIFY key id from stack outputs.
#KMS_KEY_ID=
